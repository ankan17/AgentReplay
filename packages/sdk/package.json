{
  "name": "agentreplay",
  "version": "0.0.1",
  "description": "Deterministic record/replay debugging for TypeScript LLM agents",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "agentreplay": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --conditions=development --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
