{
  "name": "agentreplay-monorepo",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*", "examples/*"],
  "engines": { "node": ">=22.18" },
  "scripts": {
    "build": "npm run build -w agentreplay",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "dashboard": "node --conditions=development apps/dashboard/src/server.ts --dir examples/support-agent/.agent-replay",
    "demo": "npm run cli -w @agentreplay/example-support-agent --"
  }
}
