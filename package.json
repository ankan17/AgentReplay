{
  "name": "agentreplay",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Deterministic record/replay debugging for TypeScript LLM agents (week-0 starter)",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "demo:record": "node demo/cli.ts record",
    "demo:show": "node demo/cli.ts show latest",
    "test": "node --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
